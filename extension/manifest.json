{
  "manifest_version": 3,
  "name": "AutoApply",
  "version": "1.0.0",
  "action": {
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background/background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "downloads",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/types.js",
        "utils/extractVisibleText.js",
        "lib/profile/profileNormalizer.js",
        "storage/appDataStore.js",
        "lib/profile/profileLoader.js",
        "storage/resumeRegistryStore.js",
        "storage/autofillKnowledgeBase.js",
        "content/applyPipeline.js",
        "content/keywordAutofill.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/mockCandidateProfile.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
