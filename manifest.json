{
  "manifest_version": 3,
  "name": "Test Extension",
  "version": "1.0.0",
  "description": "My first Chrome extension test.",
  "permissions": ["activeTab", "scripting"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
